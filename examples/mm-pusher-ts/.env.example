# RPC endpoint of the target chain
RPC_URL=https://mainnet.base.org

# Hot key that sends push transactions (compressed lane) / relay transactions (pyth lane)
PUSHER_PRIVATE_KEY=0x...
# Cold key of the feed creator (compressed lane admin ops: delegation, guards, signed updates).
# May be the same as PUSHER_PRIVATE_KEY for the zero-setup single-key flow.
CREATOR_PRIVATE_KEY=0x...

# CANONICAL production deployments, kept in sync with script/config/networks.json (CREATE3 — same
# address on every chain that carries the contract; see DEPLOYMENTS.md). The anvil demo overrides
# them with locally deployed instances.
#
# Do NOT reuse an address from an older revision of this file: every superseded generation is still
# deployed and still accepts transactions, so a stale address fails SILENTLY — pushes land in an
# oracle no provider reads. `scripts/check-doc-addresses.mjs` is the CI gate against exactly that.
COMPRESSED_ORACLE_ADDRESS=0xE844701934D9C6085B292e428F41b911cC0b3872
PYTH_ORACLE_ADDRESS=0x30a88bf894D1b806125a23ebf23D715496fD7102

# Compressed lane: which storage slot (0-255) inside the creator namespace the scripts use
SLOT_INDEX=0

# Offline mode of scripts/01-derive-feed-id.ts (no RPC): chain id for local feedId derivation
CHAIN_ID=
# Position (0-3) used by scripts/05-set-price-guard.ts
POSITION_INDEX=0

# Pyth lane (production): Pyth Lazer access (token is issued by Pyth)
LAZER_WS_URL=wss://pyth-lazer.dourolabs.app/v1/stream
LAZER_HTTP_URL=https://pyth-lazer.dourolabs.app/v1/latest_price
LAZER_ACCESS_TOKEN=
# Comma-separated Lazer uint32 feed ids, in the exact order they appear in the payload
LAZER_FEED_IDS=1,2
# Pyth lane (file mode): path to a hex-encoded signed update (used by the offline demo)
LAZER_UPDATE_FILE=

# Chainlink lane (Data Streams): production deployment (CREATE3, see DEPLOYMENTS.md)
CHAINLINK_ORACLE_ADDRESS=0x810A649974f21bB6D3b2E781597EdBDAabe82228
# Data Streams HMAC credentials — your Streams "User ID" is the API key, "Secret" the API secret.
DATA_STREAMS_API_KEY=
DATA_STREAMS_API_SECRET=
DATA_STREAMS_REST_URL=https://api.dataengine.chain.link
DATA_STREAMS_WS_URL=wss://ws.dataengine.chain.link
# WS handshake path: /api/v1/ws (code default, standard feeds) OR /api/v2/ws (High Frequency Streams
# / HA accounts). HFS feeds (id 0x1003…) require v2 — v1 rejects the handshake with HTTP 400.
DATA_STREAMS_WS_PATH=/api/v2/ws
# Data Streams feed ids. push-once (REST, script 20) needs a STANDARD v3 feed — id starts 0x0003;
# the REST /reports/latest endpoint does NOT serve High Frequency Streams (those are 0x1003…, WS-only).
# run-pusher (WS, script 21) streams and accepts either; pass a comma list. Replace with your feeds.
CHAINLINK_FEED_ID=0x000335fd3f3ffa06cfd9297b97367f77145d7a5f132e84c736cc471dd98621fe
CHAINLINK_FEED_IDS=0x1003cb4fbeae929ce9f9ae53e45d35095be85ae614c02f1d4e36f3e8ad9ed18c
