# Copy to .env and fill in your own values. Never commit the real .env file.
RPC_ETHEREUM=
RPC_BASE=
RPC_ARBITRUM=
RPC_OPTIMISM=
RPC_POLYGON=
RPC_BSC=
RPC_AVALANCHE=
RPC_BERACHAIN=
RPC_MEGAETH=
RPC_MONAD=
RPC_HYPEREVM=
# Robinhood Chain (id 4663): public https://rpc.mainnet.chain.robinhood.com is rate-limited; use Alchemy for production
RPC_ROBINHOOD=

# ── Production deploy (script/deploy-production.sh) ──
# No raw private key here. Signing goes through a foundry keystore — one-time setup:
#   cast wallet import deployer --interactive   # paste the deployer key, set a password
# forge prompts for that password only on a real broadcast (a dry-run needs no password).
DEPLOYER_ACCOUNT=deployer
DEPLOYER_ADDRESS=            # public address of the keystore: `cast wallet address --account deployer`
# Salts are per CONTRACT — see script/config/salts.json. DEPLOY_VERSION is RETIRED and the
# deploy script rejects it; set RELEASE_VERSION only when cutting a fresh full release that
# moves every contract to one new salt.
# RELEASE_VERSION=
# MAX_TIME_DRIFT=0
# Deploy runner: script/deploy-production.mjs (Node — prompts the keystore password once) or
# script/deploy-production.sh. Reconcile on-chain afterwards with script/verify-deployment.mjs.

# ── Gas funding for the deployer (script/bridge-gas.sh, via the 0x Cross-Chain API) ──
ZEROX_API_KEY=              # from https://dashboard.0x.org (used only by bridge-gas.sh)
# FROM_CHAIN=42161          # source chain id to bridge gas FROM (its RPC is derived from FROM_CHAIN)
