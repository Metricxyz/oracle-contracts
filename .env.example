# ── Provider creation (script/create-price-provider.sh, script/create-anchored-provider.sh) ──
# Both wrappers load ./.env (run them from the repo root); a variable already set in the shell or
# passed on the command line keeps its value. The key's address becomes the provider owner. The
# remaining params (NETWORK, feed ids, tokens, margins) are passed inline per invocation — see each
# script's header.
PRIVATE_KEY=
# Factory and reference-oracle addresses for NETWORK: from docs/DEPLOYMENTS.md.
PRICE_PROVIDER_FACTORY=
ANCHORED_PROVIDER_FACTORY=
REFERENCE_ORACLE=
